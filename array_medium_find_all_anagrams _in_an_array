Find All Anagrams in a String
Given strings s and p, return every start index in s where the length-len(p) window is a permutation of p. Indices may be returned in ascending order.

Example Input: s = "cbaebabacd", p = "abc"    Output:[0,6]  The substring starting at index 0 is 'cba', which is an anagram of 'abc'. The substring starting at index 6 is 'bac', which is also an anagram of 'abc'.
Input:s =  "abab", p = "ab"    Output:[0,1,2]  The substrings 'ab', 'ba', 'ab' are all anagrams of 'ab'.



class Solution:
def findAnagrams(self, s:str, p:str)->list[int]:
        if len(p)>len(s):
              return []
        result =[]
        p_count=[]
        window_count =[]
        for i in range(len(p)):
              window_count[ord(s[i])-ord('a')]+=1
`             p_count[ord(p[i])-ord('a')]+=1
        if window_count ==p_count:
              result.append(0)
        left =0
        for right in range(len(p), len(s)):
              window_count[ord(s[right])-ord('a')]+=1
              window_count[ord(s[left])-ord('a')-=1
              left+=1
              if p_count ==window_count:
                  result.append(left)
        return result
